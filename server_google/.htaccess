RewriteEngine On
# turn on the mod_rewrite engine

RewriteCond %{REQUEST_FILENAME}.php -f
# IF the request filename with .php extension is a file which exists
RewriteCond %{REQUEST_URI} !/$
# AND the request is not for a directory
RewriteRule (.*) $1\.php [L]
# redirect to the php script with the requested filename

RewriteCond %{HTTP_HOST} ^m\.youimax\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.m\.youimax\.com$
RewriteRule ^/?$ "http\:\/\/m\.youimax\.com" [R=301,L]
#page mode rewrite
RewriteRule    ^Home/$    index.php    [NC,L]    # Process index requests
RewriteRule    ^Models/$    allmodel.php    [NC,L]    # Process shop requests
RewriteRule    ^Recruiters/$    allemployee.php    [NC,L]    # Process discover requests
RewriteRule    ^Desposit-account/$    payment_page.php    [NC,L]    # Process discover requests

RewriteRule    ^Contests/$    alladmin_contest.php    [NC,L]    # Process collection requests
RewriteRule    ^login/$    loginpanel.php    [NC,L]    # Process closet requests
RewriteRule    ^signup/$    m_register.php    [NC,L]    # Process shop requests
RewriteRule    ^Model-register/$    m_register.php    [NC,L]    # Process shop requests
RewriteRule    ^Recruiter-register/$    r_register.php    [NC,L]    # Process shop requests

RewriteRule    ^user-dashboard/$    fulldashboard.php    [NC,L]    # Process shop requests
RewriteRule    ^post-project/$    create_project.php    [NC,L]    # Process shop requests
RewriteRule    ^browse-project/$    allprojects.php    [NC,L]    # Process shop requests
RewriteRule    ^model-step1/$    mstep1.php    [NC,L]    # Process shop requests
RewriteRule    ^model-step2/$    mstep2.php    [NC,L]    # Process shop requests
RewriteRule    ^model-step3/$    mstep3.php    [NC,L]    # Process shop requests
RewriteRule    ^Gallery-add-model/$    gallery_model.php    [NC,L]    # Process shop requests
RewriteRule    ^payment_succefull/$    succefully.php    [NC,L]    # Process shop requests

RewriteRule    ^recuiter-step1/$    rstep1.php    [NC,L]    # Process shop requests
RewriteRule    ^recuiter-step2/$    rstep2.php    [NC,L]    # Process shop requests

RewriteRule    ^model-register/$    registersuccesfulmodel.php    [NC,L]    # Process shop requests
RewriteRule    ^recuiter-current/$    registercurrent.php    [NC,L]    # Process shop requests
RewriteRule    ^recuiter-past/$    registerpast.php    [NC,L]    # Process shop requests


RewriteRule    ^signout/$    logout.php    [NC,L]    # Process shop requests
RewriteRule    ^view-project/([A-Za-z0-9-]+)/$    details_project.php?pid=$1    [NC,L]    # Process shop requests

RewriteRule    ^user-profile/([A-Za-z0-9-]+)/$    fullprofile.php?userid=$1    [NC,L]    # Process shop requests
RewriteRule    ^Project-Detail/([A-Za-z0-9-]+)/$    showbids.php?pid=$1    [NC,L]    # Process shop requests

RewriteRule    ^payment-method/([A-Za-z0-9-]+)/$    paymentsall.php?pid=$1    [NC,L]    # Process shop requests


RewriteRule    ^Recruiter-profile/([A-Za-z0-9-]+)/?$    recuiterprofile.php?userid=$1    [NC,L]    # Process shop requests

RewriteRule    ^contest-detail/([A-Za-z0-9-]+)/?$    deatils_contest.php?contest_id=$1    [NC,L]    # Process blog posts