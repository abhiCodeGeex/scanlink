# --- Dependencies ---
/vendor
/node_modules

# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.docker.example
auth.json

# --- IDE / OS / agent junk ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.zed/
.nova/
.cursor/
.codex/
*.swp
*.swo

# --- Logs & dumps (never commit live DB) ---
*.log
*.sql
*.sql.gz
*.dump
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# --- PHP / testing caches ---
.phpunit.result.cache
.phpunit.cache/
.phpactor.json
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
Homestead.json
Homestead.yaml

# --- Frontend build / Vite ---
/public/build
/public/hot
/public/fonts-manifest.dev.json
/public/storage

# --- Laravel storage (keep structure via nested .gitignore files) ---
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
# Local DB exports / migration dumps under storage
/storage/app/migration/
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# --- Uploaded / generated media (local only) ---
/public/uploads/
/assets/

# --- Docker / local runtime leftovers ---
docker-compose.override.yml
*.pid

# --- Local AI assistant / project notes (not part of the app) ---
/.cursor/
/.playwright-mcp/
/.claude/
/CLAUDE.md
/PROJECT_HISTORY.md

# --- Local one-off probes / browser harnesses (not product code) ---
/scripts/browser-*
/scripts/debug-*
/scripts/probe-*
/scripts/check-*
/scripts/compare-*
/scripts/inspect-*
/scripts/list-*
/scripts/lookup-*
/scripts/ensure-*
/scripts/try-*
/scripts/verify-*
/scripts/render-*
/scripts/seed-*
/scripts/set-client-*
/scripts/setup-form-*
/scripts/regress-*
/scripts/regen-*
/scripts/analyze-*
/scripts/cleanup-*
/scripts/create-*-login.php
/scripts/create-portal-*
/scripts/dump-*
/scripts/fix-admin-*
/scripts/generate_*
/scripts/live-server-*
/scripts/screenshot-*
